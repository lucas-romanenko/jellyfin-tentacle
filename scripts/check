#!/usr/bin/env bash
# The full test suite, as CI runs it (.github/workflows/tests.yml calls this
# script): the Python unit tests with the real requirements. The workbench's
# global pre-push hook (~/homelab/git-hooks) runs this before main moves.
#
#   scripts/check [-j N] [unittest args, e.g. -v]   the whole suite in N parallel shards
#                                                   (default: the machine's cores, at most 4)
#   scripts/check --shard K/N [-j M] [-v]           one shard (each CI job runs one of 4),
#                                                   in M parallel parts (default 1)
#   scripts/check --durations                       run everything, rewrite tests/durations.json
#
# The shards are whole test modules balanced by tests/durations.json
# (tests/shards.py); together they are exactly the suite discover finds.
# -j 1 runs it all in one process, as before.
#
# The virtualenv lives outside the repo, one per requirements.txt version,
# so it's built once and reused (also by the hook's temporary checkouts).
# CHECK_PYTHON=python uses that interpreter instead (CI installs the
# requirements itself).
#
# The suite runs without the network (tests/hermetic.py: no DNS, loopback
# connections only), so it passes or fails the same everywhere.
#
# Each shard runs with a TMPDIR of its own, and anything left in it afterwards
# fails the check: every test removes what it creates (tests/tmp_dirs.py).
# A run used to leave about a thousand t.db / cache / .strm dirs in /tmp.
set -euo pipefail
cd "$(dirname "$0")/.."

jobs= shard= durations=
while [ $# -gt 0 ]; do
	case $1 in
	-j) jobs=$2; shift 2 ;;
	-j[0-9]*) jobs=${1#-j}; shift ;;
	--shard) shard=$2; shift 2 ;;
	--durations) durations=1; shift ;;
	*) break ;;
	esac
done
if [ -z "$jobs" ]; then
	jobs=$(nproc 2>/dev/null || echo 1)
	[ "$jobs" -le 4 ] || jobs=4
	[ -z "$shard" ] || jobs=1   # one CI shard: one process unless -j says otherwise
fi
case $jobs in ''|*[!0-9]*|0) echo "check: -j wants a number of shards, got '$jobs'" >&2; exit 2 ;; esac

python=${CHECK_PYTHON:-}
if [ -z "$python" ]; then
	req=tentacle/requirements.txt
	venv="${XDG_CACHE_HOME:-$HOME/.cache}/jellyfin-tentacle/check-venv-$(sha256sum "$req" | cut -c1-12)"
	if [ ! -f "$venv/.ready" ]; then
		echo "check: building the test virtualenv in $venv (once per requirements.txt)…"
		rm -rf "$venv"
		python3 -m venv "$venv"
		"$venv/bin/pip" install --quiet --disable-pip-version-check -r "$req"
		touch "$venv/.ready"
	fi
	python=$venv/bin/python
fi

tmp=$(mktemp -d "${TMPDIR:-/tmp}/tentacle-check.XXXXXX")
trap 'rm -rf "$tmp"' EXIT
cd tentacle

# leftovers <dir> <label>: fail when the tests left anything in their TMPDIR
leftovers() {
	local left
	left=$(find "$1" -mindepth 1 -maxdepth 1 | wc -l)
	[ "$left" -gt 0 ] || return 0
	echo "check: $2left $left item(s) in TMPDIR; each test must remove what it creates (use temp_dir from tests/tmp_dirs.py):" >&2
	(cd "$1" && find . -mindepth 1 -maxdepth 2 | sed 's|^\./||' | sort | head -30) >&2 || true   # head closes the pipe early
	return 1
}

status=0
if [ "$jobs" -eq 1 ] && [ -z "$durations" ]; then
	mkdir "$tmp/t"
	if [ -n "$shard" ]; then
		TMPDIR=$tmp/t "$python" tests/shards.py "$shard" "$@" || status=$?
	else
		TMPDIR=$tmp/t "$python" tests/hermetic.py discover -s tests "$@" || status=$?
	fi
	leftovers "$tmp/t" "the tests " || [ "$status" -ne 0 ] || status=1
	exit "$status"
fi

# N shards side by side (or the N parts of one shard), each with its own
# TMPDIR and log; the logs are shown one after the other when all are done
start=$SECONDS
record=${TENTACLE_DURATIONS:-}   # timings asked for by the caller (CI): one file per part, merged below
[ -z "$durations" ] || record=tests/durations.json
specs=() pids=()
for k in $(seq "$jobs"); do
	specs+=("${shard:+$shard.}$k/$jobs")
	mkdir "$tmp/t$k"
	if [ -n "$record" ]; then export TENTACLE_DURATIONS=$tmp/d$k.json; fi
	TMPDIR=$tmp/t$k "$python" tests/shards.py "${specs[k-1]}" "$@" >"$tmp/log$k" 2>&1 &
	pids+=($!)
done
summary=()
for k in $(seq "$jobs"); do
	s=0
	wait "${pids[k-1]}" || s=$?
	cat "$tmp/log$k"
	leftovers "$tmp/t$k" "the tests of shard ${specs[k-1]} " || [ "$s" -ne 0 ] || s=1
	[ "$s" -eq 0 ] || status=1
	summary+=("shard ${specs[k-1]}: $([ "$s" -eq 0 ] && echo ok || echo FAILED), $(grep -E '^Ran [0-9]+ test' "$tmp/log$k" | tail -1 || echo 'did not finish')")
done
echo
printf 'check: %s\n' "${summary[@]}"
echo "check: $jobs shards, $(grep -hE '^Ran [0-9]+ test' "$tmp"/log* | awk '{n += $2} END {print n + 0}') tests, $((SECONDS - start))s wall; $([ "$status" -eq 0 ] && echo OK || echo FAILED)"

if [ -n "$durations" ] && [ "$status" -ne 0 ]; then
	echo "check: not writing tests/durations.json from a failing run" >&2
elif [ -n "$record" ]; then
	"$python" tests/shards.py --merge "$tmp"/d*.json >"$record"
	echo "check: wrote the timings of $(grep -c '"' "$record") modules to $record"
fi
exit "$status"
